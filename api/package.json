{
  "name": "@upcat/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx-server.ts",
    "dev:compiled": "node --env-file=.env dist/server.js",
    "dev:vercel": "vercel dev --listen 3001",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:auth": "node scripts/migrate-auth.mjs",
    "migrate:question-workflow": "node scripts/migrate-question-workflow.mjs",
    "normalize:exam-set-assignments": "node scripts/normalize-exam-set-assignments.mjs",
    "setup-indexes": "node scripts/setup-indexes.js",
    "seed": "node scripts/seed.js",
    "seed:clean": "node scripts/seed.js --clean"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1011.0",
    "@types/busboy": "^1.5.4",
    "@upcat/shared": "file:../shared",
    "@node-rs/bcrypt": "^1.10.4",
    "busboy": "^1.6.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "resend": "^4.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/web-push": "^3.6.4",
    "@vercel/node": "latest",
    "tsx": "^4.20.6",
    "typescript": "~5.6.0",
    "vercel": "latest",
    "vitest": "^2.1.9"
  }
}