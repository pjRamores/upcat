{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "functions": {
    "api/functions/**/*.ts": {
      "runtime": "@vercel/node@3.2.0"
    },
    "crons": [
      {
        "path": "/api/cron/execute-deletions",
        "schedule": "0.*.*.*.*"
      },
      {
        "path": "/api/cron/cleanup-exports",
        "schedule": "0.*/6.*.*.*"
      },
      {
        "path": "/api/cron/auto-close-tickets",
        "schedule": "0.3.*.*.*"
      },
      {
        "path": "/api/cron/inactivity-check",
        "schedule": "0.4.*.*.1"
      },
      {
        "path": "/api/cron/assign-weekly-challenges",
        "schedule": "0.4.*.*.1"
      },
      {
        "path": "/api/cron/study-reminders",
        "schedule": "0,30.*.*.*.*"
      },
      {
        "path": "/api/cron/streak-warnings",
        "schedule": "0.19.*.*.*"
      },
      {
        "path": "/api/cron/threat-score-decay",
        "schedule": "0.*.*.*.*"
      },
      {
        "path": "/api/cron/security-cleanup",
        "schedule": "*/15.*.*.*.*"
      },
      {
        "path": "/api/cron/security-report",
        "schedule": "0.0.*.*.*"
      },
      {
        "path": "/api/cron/ip-intelligence-aggregation",
        "schedule": "30.0.*.*.*"
      },
      {
        "path": "/api/cron/monitoring-health-checks",
        "schedule": "*/5.*.*.*.*"
      },
      {
        "path": "/api/cron/monitoring-alert-rules",
        "schedule": "*/5.*.*.*.*"
      },
      {
        "path": "/api/cron/maintenance-auto-start",
        "schedule": "*.*.*.*.*"
      },
      {
        "path": "/api/cron/maintenance-auto-end",
        "schedule": "*.*.*.*.*"
      },
      {
        "path": "/api/cron/sync-queue-cleanup",
        "schedule": "*/30.*.*.*.*"
      }
    ],
    "rewrites": [
      {
        "source": "/api/auth/providers",
        "destination": "/api/functions/auth/providers"
      },
      {
        "source": "/api/auth/social/:provider/start",
        "destination": "/api/functions/auth/social/start?provider=:provider"
      },
      {
        "source": "/api/auth/social/:provider/callback",
        "destination": "/api/functions/auth/social/callback?provider=:provider"
      },
      {
        "source": "/api/auth/linked-accounts",
        "destination": "/api/functions/auth/linked-accounts"
      },
      {
        "source": "/api/auth/unlink",
        "destination": "/api/functions/auth/unlink"
      },
      {
        "source": "/api/auth/set-password",
        "destination": "/api/functions/auth/set-password"
      },
      {
        "source": "/api/auth/recovery-codes/generate",
        "destination": "/api/functions/auth/recovery-codes?action=generate"
      }
    ]
    ]
  }
{
