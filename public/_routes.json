{
  "version": 1,
  "description": "Cloudflare Pages routing configuration for UPCAT Simulator SPA",
  "include": [
    "/**"
  ],
  "exclude": [
    "/api/*",
    "/worker.js",
    "/manifest.webmanifest",
    "/service-worker.js",
    "/icons/**",
    "*.svg",
    "*.png",
    "*.ico",
    "*.woff2",
    "*.woff",
    "*.ttf",
    "/assets/**"
  ],
  "rules": [
    {
      "type": "function",
      "function": "api"
    },
    {
      "type": "rewrite",
      "path": "/index.html"
    }
  ]
}