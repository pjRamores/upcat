{
  "version": 1,
  "description": "Cloudflare Pages routing configuration for UPCAT Simulator SPA",
  "include": [
    "/*"
  ],
  "exclude": [
    "/api/*",
    "/_worker.js",
    "/manifest.webmanifest",
    "/service-worker.js",
    "/icons/*",
    "/*.svg",
    "/*.png",
    "/*.ico",
    "/*.woff",
    "/*.woff2",
    "/*.ttf",
    "/assets/*"
  ],
  "rules": [
    {
      "type": "function",
      "function": "api"
    },
    {
      "type": "rewrite",
      "path": "/index.html"
    }
  ]
}